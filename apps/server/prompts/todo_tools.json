[
  {
    "type": "function",
    "function": {
      "name": "todo_search",
      "description": "查询本人跨渠道待办，字面搜索和分页。",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "todo_get",
      "description": "读取待办、安排、来源、事件与每期实际处理结果。",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "todo_create",
      "description": "按用户明确指令创建待办，可同时添加一次性、周期或回访安排。",
      "parameters": {
        "type": "object",
        "properties": {
          "content": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "objective": {
                "type": "string"
              },
              "completion_criteria": {
                "type": "string"
              },
              "next_action": {
                "type": "string"
              },
              "waiting_on": {
                "type": "string"
              },
              "due_at": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "事情截止时间，RFC3339；空值表示无截止时间"
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          },
          "schedule": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "reminder",
                  "checkin",
                  "execute"
                ]
              },
              "next_run_at": {
                "type": "string"
              },
              "timezone": {
                "type": "string"
              },
              "recurrence": {
                "type": "string",
                "enum": [
                  "once",
                  "daily",
                  "weekdays",
                  "weekly",
                  "monthly"
                ]
              },
              "ends_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "missed_policy": {
                "type": "string",
                "enum": [
                  "skip",
                  "latest"
                ]
              },
              "grace_minutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10080
              },
              "instruction": {
                "type": "string"
              },
              "channel": {
                "type": "string",
                "enum": [
                  "inherit",
                  "web",
                  "feishu"
                ],
                "description": "默认 inherit：新建继承当前渠道，修改保留原目标。仅用户明确指定渠道时使用 web/feishu，并提供 channel_evidence。"
              }
            },
            "required": [
              "kind",
              "next_run_at",
              "timezone",
              "recurrence",
              "missed_policy",
              "grace_minutes"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "type": "string"
          },
          "channel_evidence": {
            "type": "string",
            "description": "显式指定渠道时，逐字引用本轮用户包含目标渠道的完整正向分句，以逗号、句号、分号或换行分隔；不得截掉否定词。默认继承时省略。"
          }
        },
        "required": [
          "content",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "todo_update",
      "description": "按完整正文和版本更新待办；完成或取消同时停止其所有安排。",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "content": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "objective": {
                "type": "string"
              },
              "completion_criteria": {
                "type": "string"
              },
              "next_action": {
                "type": "string"
              },
              "waiting_on": {
                "type": "string"
              },
              "due_at": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "事情截止时间，RFC3339；空值表示无截止时间"
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "waiting_external",
              "needs_user",
              "completed",
              "cancelled"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "content",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
