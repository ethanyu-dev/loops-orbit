  {
    "type": "function",
    "function": {
      "name": "todo_link",
      "description": "关联本人可访问的会话、资料、知识或 Linear issue。",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "kind": {
            "type": "string",
