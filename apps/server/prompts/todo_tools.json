              "knowledge",
              "linear"
            ]
          },
          "resource_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "kind",
          "resource_id",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "todo_run_complete",
      "description": "按用户明确说明记录某一期已完成，后续周期保持运行。先读取 todo_get 确认期次。",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "note": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "run_id",
          "version",
          "note",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  }
]
