# 本地开发使用此数据库；生产环境通过 Railway 变量引用注入。
DATABASE_URL=postgres://orbit:orbit_local@localhost:55433/orbit
# 使用 openssl rand -hex 32 生成，不要提交真实密钥。
ADMIN_TOKEN=replace-with-a-random-token-at-least-32-bytes
# 前端唯一可信源；生产例如 https://orbit.ethankit.com。
PUBLIC_URL=http://localhost:5173
# Rust API 的公开源；生产使用 https://api-orbit.ethankit.com。
API_PUBLIC_URL=http://localhost:8080
PORT=8080
WORKER_CONCURRENCY=2
RUST_LOG=orbit_server=info,agent_runtime=info

# 兼容 OpenAI Chat Completions 的 API 根路径，不包含 /chat/completions。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=your-model-name
OPENAI_API_KEY=your-api-key
AGENT_TOOLS_ENABLED=true
# 不支持 SSE 流式响应的代理可关闭；仍可接收完整 JSON 回复。
AGENT_STREAM_ENABLED=true

# 首版飞书为加密事件回调模式，仅接受白名单用户的单聊文本。
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=
# FEISHU_ALLOWED_USERS=ou_xxx,ou_yyy

# 用户身份的只读聊天采集，与机器人入口独立；需要 MEMORY_ENABLED=true。
FEISHU_SYNC_ENABLED=false
# 独立密钥：使用 openssl rand -hex 32 生成，妥善备份，不复用 ADMIN_TOKEN。
# FEISHU_TOKEN_KEY=
# 用户 OAuth 回调：API_PUBLIC_URL/api/communications/oauth/callback

# 默认使用本地原文 + 中文 BM25。生产 MEMORY_DIR 必须挂载持久卷，应用仅支持单实例。
MEMORY_ENABLED=true
MEMORY_DIR=memory
MEMORY_AUTO_EXTRACT=true
# 向量模型单独配置；不填则使用 BM25，不会误用聊天模型。
# EMBEDDING_BASE_URL=https://your-embedding-provider/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=1024
# 同名模型升级时递增，触发向量重建。
# EMBEDDING_REVISION=1
# 需用自己的语料校准，低于此余弦相似度的语义候选不返回。
MEMORY_MIN_SIMILARITY=0.55

# 新身份的默认提醒时区；用户可在“提醒与跟进”中修改，已有提醒保持原时刻。
FOLLOWUP_TIMEZONE=Asia/Shanghai
# 主动回访默认关闭，由各身份在页面或聊天中显式开启，不回填旧聊天。

# Linear 个人 API Key：留空关闭；在 Linear 个人安全设置中创建，选择 Read/Write 权限。
LINEAR_API_KEY=
# 可选，限制允许绑定的工作空间 URL 标识。
LINEAR_WORKSPACE_SLUG=pplabs
